{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.grok-sandbox.com" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), payment=(self), interest-cohort=()" }
      ]
    },
    {
      "source": "/passwort-neu",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ]
}
